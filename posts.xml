---
layout: null
permalink: /posts.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — Posts</title>
    <link>{{ '/' | absolute_url }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>en-us</language>
    <atom:link href="{{ '/posts.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {% assign essays = site.posts | where_exp: "post", "post.layout != 'link'" %}
    {% for post in essays limit:40 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <author>{{ site.author.email | xml_escape }} ({{ site.author.name | xml_escape }})</author>
      <description><![CDATA[
        {{ post.content | replace: ']]>', ']]]]><![CDATA[>' }}
      ]]></description>
    </item>
    {% endfor %}
  </channel>
</rss>
