---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    {%- if post.last_modified_at -%}
    "last_modified": {{ post.last_modified_at | date: "%Y-%m-%d" | jsonify }},
    {%- endif -%}
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},
    {%- if post.description -%}
    "description": {{ post.description | strip_html | strip_newlines | truncate: 200 | jsonify }},
    {%- endif -%}
    {%- if post.reading_time -%}
    "reading_time": {{ post.reading_time }},
    {%- endif -%}
    "tags": {{ post.tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
{% if site.posts.size > 0 and site.data.link_posts.size > 0 %},{% endif %}
{% for link in site.data.link_posts %}
  {
    "kind": "link",
    "title": {{ link.title | jsonify }},
    "url": {{ link.url | relative_url | jsonify }},
    "date": {{ link.date | date: "%Y-%m-%d" | jsonify }},
    "excerpt": {{ link.excerpt | default: link.description | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "tags": {{ link.tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
